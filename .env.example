# Geppetto configuration – copied to ~/geppetto/.env by `geppetto init`.
# Keep that file at mode 600: it contains secrets. Do not commit it anywhere.
# Format: KEY=value, one per line, no spaces around "=". Values may contain spaces;
# quotes are optional. The file is read as data, never executed.

# GitHub fine-grained personal access token
#   Resource owner: your account; Repository access: only your module forks
#   Permissions: Contents: Read and write, Workflows: Read and write (nothing else;
#   Workflows is needed to push changes to .github/workflows/, e.g. after pm pdk-update)
#   Use a dedicated token for Geppetto.
GH_TOKEN=

# Your GitHub account that owns the forks. The upstream repository is detected
# from each fork's parent on GitHub (override with `geppetto start --upstream`).
GEPPETTO_GITHUB_OWNER=

# Puppet Core / Forge API key: PDK download, puppetcore gems, agent install in tests
PUPPET_FORGE_TOKEN=

# Git identity for commits made by agents: your own, so GitHub attributes the
# commits to you (you review them and open the PR). Agents add an
# "Assisted-by:" trailer. If GitHub blocks pushes that expose your email, use your
# <ID>+<user>@users.noreply.github.com address (GitHub settings > Emails).
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# Defaults
GEPPETTO_DEFAULT_PDK=4.0.1        # used when metadata.json has no pdk-version
GEPPETTO_AGENTS=copilot           # agent CLIs installed in images: copilot,claude,codex
GEPPETTO_AGENT=copilot            # agent started by `geppetto start`
# GEPPETTO_GEM_SOURCE=auto        # auto: Puppet Core gems with PDK >= 4, public gems
#                                 # with PDK 3.x (ships Puppet 8.10); or puppetcore|public
# GEPPETTO_COLLECTION=puppetcore9 # agent collection for acceptance tests
#                                 # (default: puppetcore9 with Puppet Core, else puppet8)
