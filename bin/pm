#!/usr/bin/env bash
# pm – Puppet module commands inside a Pinocchio.
#
# One uniform interface for every agent: clear output, meaningful exit codes.
# Run from anywhere inside a module checkout. `pm help` for usage.
set -euo pipefail

# --------------------------------------------------------------------------- helpers

die()  { printf 'pm: error: %s\n' "$*" >&2; exit 1; }
info() { printf '==> %s\n' "$*"; }
warn() { printf 'pm: warning: %s\n' "$*" >&2; }

usage() {
    cat <<'EOF'
Usage: pm <command> [options]

  info                      Show module, PDK versions, gem source, branch and remotes
  setup                     Check remotes, fetch upstream, install the bundle
  branch TOPIC              Create branch agent/TOPIC from the upstream default branch
  validate [PDK_ARGS...]    pdk validate
  unit [PDK_ARGS...]        pdk test unit
  acceptance [options]      Litmus acceptance tests
      --set NAME            provision.yaml set to use (default: default)
      --image IMAGE         Provision this Docker image instead of a provision.yaml set
                            (repeatable), e.g. litmusimage/ubuntu:22.04; leaves the
                            module's files unchanged
      --inventory FILE      Test existing machines from FILE instead of provisioning
      --collection NAME     Agent collection (default: GEPPETTO_COLLECTION,
                            puppetcore9 for Puppet Core gems, else puppet8)
      --keep                Keep the test machines after the run (no tear down)
  target up [options]       Start a test machine with Puppet and this module installed
      --set NAME | --image IMAGE | --collection NAME   (as for acceptance)
  apply FILE.pp | -e 'MANIFEST' [--noop]
                            Reinstall the module, run puppet apply on the test machine,
                            then a second run as idempotence check (always)
  target exec 'COMMAND'     Run a command on the test machine, e.g. 'cat /etc/motd'
  target down               Remove the test machine
  pdk-update [--noop]       Update the module to this container's PDK, then validate + unit
  push                      Push the current agent/* branch to your fork

Exit code 0 means success; anything else means the step failed.
EOF
}

find_module_root() {
    local dir
    dir="$(pwd -P)"
    while [[ "${dir}" != "/" ]]; do
        if [[ -f "${dir}/metadata.json" ]]; then
            MODULE_ROOT="${dir}"
            return
        fi
        dir="$(dirname "${dir}")"
    done
    die "no metadata.json found here or in a parent directory; cd into a module checkout."
}

module_pdk_version() { jq -r '."pdk-version" // empty' "${MODULE_ROOT}/metadata.json"; }
container_pdk_version() { pdk --version 2>/dev/null | tail -n 1; }

# Run PDK with known harmless noise removed from stderr, so agents do not try to "fix"
# it. Currently: the Ruby 4 warning from the `logging` gem about `syslog`.
pdk_run() {
    pdk "$@" 2> >(grep -vE 'logging\.rb:[0-9]+: warning: syslog used to be loaded|^You can add syslog to your Gemfile or gemspec' >&2)
}

# Which gem world to use: Puppet Core or public rubygems.org.
#
# PDK 3.x ships Puppet 8.10.0, the last public release; Puppet Core's gems (bolt in
# particular) need Puppet >= 8.11, so PDK 3.x only works with the public gems.
# PDK 4.x ships Puppet 8.22 and 9.x and works with Puppet Core.
# GEPPETTO_GEM_SOURCE=auto (default) | puppetcore | public overrides the choice.
GEM_WORLD=""
GEM_WORLD_REASON=""

decide_gem_world() {
    local wanted="${GEPPETTO_GEM_SOURCE:-auto}" major
    major="$(container_pdk_version | cut -d. -f1)"
    case "${wanted}" in
        public)
            GEM_WORLD=public; GEM_WORLD_REASON="GEPPETTO_GEM_SOURCE=public" ;;
        puppetcore)
            GEM_WORLD=puppetcore; GEM_WORLD_REASON="GEPPETTO_GEM_SOURCE=puppetcore" ;;
        auto)
            if [[ "${major}" =~ ^[0-9]+$ ]] && ((major < 4)); then
                GEM_WORLD=public
                GEM_WORLD_REASON="PDK ${major}.x ships Puppet 8.10, which Puppet Core gems do not support"
            else
                GEM_WORLD=puppetcore; GEM_WORLD_REASON="PDK ${major}.x"
            fi ;;
        *) die "GEPPETTO_GEM_SOURCE must be auto, puppetcore or public (is '${wanted}')." ;;
    esac
    if [[ "${GEM_WORLD}" == puppetcore && -z "${FORGE_TOKEN}" ]]; then
        GEM_WORLD=public; GEM_WORLD_REASON="no PUPPET_FORGE_TOKEN"
    fi
}

gem_source() {
    if [[ "${GEM_WORLD}" == puppetcore ]]; then
        echo "puppetcore (rubygems-puppetcore.puppet.com; ${GEM_WORLD_REASON})"
    else
        echo "public rubygems.org (${GEM_WORLD_REASON})"
    fi
}

# Puppet Core gem credentials for Bundler.
#
# PDK runs Bundler in a clean environment: it drops every BUNDLE_* variable and sets
# BUNDLE_IGNORE_CONFIG=1, so neither BUNDLE_RUBYGEMS___PUPPETCORE__PUPPET__COM nor
# ~/.bundle/config reach Bundler. What does reach it is PUPPET_FORGE_TOKEN and the
# module Gemfile, which (like every PDK-templated Gemfile) evaluates ~/.gemfile.
# ~/.gemfile therefore sets the credentials in Bundler's in-memory settings from
# PUPPET_FORGE_TOKEN. The file itself contains no secret.
GEMFILE_MARKER='# Managed by Geppetto (pm): Puppet Core credentials'

sync_bundle_credentials() {
    local gemfile="${HOME}/.gemfile"
    if [[ -f "${gemfile}" ]] && ! grep -qF "${GEMFILE_MARKER}" "${gemfile}"; then
        warn "${gemfile} exists and is not managed by Geppetto; Puppet Core credentials not configured."
    else
        cat > "${gemfile}" <<RUBY
${GEMFILE_MARKER}
# PDK runs Bundler with BUNDLE_IGNORE_CONFIG=1 and without BUNDLE_* variables, so the
# credentials are set in memory here, when the module Gemfile evaluates ~/.gemfile.
geppetto_forge_token = ENV['PUPPET_FORGE_TOKEN'].to_s
if !geppetto_forge_token.empty? && defined?(Bundler) && Bundler.respond_to?(:settings)
  Bundler.settings.temporary('rubygems-puppetcore.puppet.com' => "forge-key:#{geppetto_forge_token}")
end
RUBY
    fi
    # Remove credentials an earlier Geppetto version wrote to ~/.bundle/config.
    local config="${HOME}/.bundle/config"
    if [[ -f "${config}" ]] && grep -q 'PUPPETCORE__PUPPET__COM' "${config}"; then
        local tmp
        tmp="$(mktemp "${config}.XXXXXX")"
        grep -v 'PUPPETCORE__PUPPET__COM' "${config}" > "${tmp}" || true
        chmod 600 "${tmp}"
        mv "${tmp}" "${config}"
    fi
}

prepare_env() {
    # Keep the key for the secret check in `pm push`, whatever the gem world.
    FORGE_TOKEN="${PUPPET_FORGE_TOKEN:-}"
    decide_gem_world
    sync_bundle_credentials
    # The module Gemfile switches to Puppet Core whenever PUPPET_FORGE_TOKEN is set,
    # so hide it from PDK, Bundler and Litmus in the public gem world.
    if [[ "${GEM_WORLD}" == public ]]; then
        unset PUPPET_FORGE_TOKEN
    fi
}

check_pdk_match() {
    local mod cont
    mod="$(module_pdk_version)"
    cont="$(container_pdk_version)"
    if [[ -n "${mod}" && "${mod}" != "${cont}" ]]; then
        warn "module was generated with PDK ${mod}, this container runs PDK ${cont}."
        warn "results may differ; use 'pm pdk-update' to move the module to PDK ${cont}."
    fi
}

# Re-install the bundle when the PDK version changed or the Gemfile is newer.
ensure_bundle() {
    local force="${1:-}"
    local marker="${MODULE_ROOT}/.bundle/geppetto-pdk-version"
    local current
    current="$(container_pdk_version) ${GEM_WORLD}"
    if [[ -n "${force}" || ! -f "${marker}" || "$(cat "${marker}")" != "${current}" \
          || "${MODULE_ROOT}/Gemfile" -nt "${marker}" ]]; then
        info "Installing bundle for PDK $(container_pdk_version) (gems: $(gem_source))"
        (cd "${MODULE_ROOT}" && pdk_run bundle install)
        mkdir -p "$(dirname "${marker}")"
        echo "${current}" > "${marker}"
    fi
}

git_m() { git -C "${MODULE_ROOT}" "$@"; }

# OWNER/REPO of a GitHub remote (empty if missing or not on GitHub).
github_repo() {
    local url
    url="$(git_m remote get-url "$1" 2>/dev/null || true)"
    [[ "${url}" =~ github\.com[:/]([^/]+/[^/]+)$ ]] || return 0
    printf '%s' "${BASH_REMATCH[1]%.git}"
}

default_branch() {
    local remote="$1" ref
    ref="$(git_m symbolic-ref --quiet "refs/remotes/${remote}/HEAD" 2>/dev/null || true)"
    if [[ -z "${ref}" ]]; then
        git_m remote set-head "${remote}" --auto >/dev/null 2>&1 || true
        ref="$(git_m symbolic-ref --quiet "refs/remotes/${remote}/HEAD" 2>/dev/null || true)"
    fi
    [[ -n "${ref}" ]] || die "cannot determine the default branch of '${remote}'."
    printf '%s' "${ref#refs/remotes/${remote}/}"
}

run_rake() { (cd "${MODULE_ROOT}" && pdk_run bundle exec rake "$@"); }

# --------------------------------------------------------------------------- commands

cmd_info() {
    local branch
    branch="$(git_m rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
    cat <<EOF
Module:        $(jq -r '.name' "${MODULE_ROOT}/metadata.json") ($(jq -r '.version' "${MODULE_ROOT}/metadata.json"))
Path:          ${MODULE_ROOT}
PDK module:    $(module_pdk_version || true)
PDK container: $(container_pdk_version)
Gem source:    $(gem_source)
Branch:        ${branch}
Remotes:
$(git_m remote -v | sed 's/^/  /')
EOF
    check_pdk_match
}

cmd_setup() {
    git_m remote get-url origin >/dev/null 2>&1 || die "remote 'origin' (your fork) is missing."
    if git_m remote get-url upstream >/dev/null 2>&1; then
        git_m remote set-url --push upstream DISABLED
        info "Fetching upstream"
        git_m fetch --quiet upstream || warn "could not fetch upstream."
    else
        warn "remote 'upstream' is missing; add it with: git remote add upstream https://github.com/<owner>/<repo>.git"
    fi
    git_m fetch --quiet origin || warn "could not fetch origin."
    check_pdk_match
    ensure_bundle force
    info "Setup complete."
}

cmd_branch() {
    local topic="${1:-}"
    [[ -n "${topic}" ]] || die "branch: which topic? e.g. pm branch issue-123"
    topic="${topic#agent/}"
    [[ "${topic}" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ ]] || die "invalid topic '${topic}'."
    local base_remote=upstream
    git_m remote get-url upstream >/dev/null 2>&1 || base_remote=origin
    git_m fetch --quiet "${base_remote}"
    local base
    base="${base_remote}/$(default_branch "${base_remote}")"
    git_m switch --no-track -c "agent/${topic}" "${base}"
    info "Created agent/${topic} from ${base}."
}

cmd_validate() {
    check_pdk_match
    ensure_bundle
    info "pdk validate $*"
    (cd "${MODULE_ROOT}" && pdk_run validate "$@")
    info "validate: OK"
}

cmd_unit() {
    check_pdk_match
    ensure_bundle
    info "pdk test unit $*"
    (cd "${MODULE_ROOT}" && pdk_run test unit "$@")
    info "unit: OK"
}

# --------------------------------------------------------------------------- test machines
#
# Shared by `pm acceptance` and `pm target`/`pm apply`. Litmus keeps the machines it
# provisions in spec/fixtures/litmus_inventory.yaml (ignored by PDK modules' .gitignore).

inventory_file() { printf '%s' "${MODULE_ROOT}/spec/fixtures/litmus_inventory.yaml"; }

inventory_has_targets() {
    local inv
    inv="$(inventory_file)"
    [[ -s "${inv}" ]] && grep -qE '^[[:space:]]*-?[[:space:]]*uri:' "${inv}"
}

default_collection() {
    if [[ -n "${GEPPETTO_COLLECTION:-}" ]]; then
        echo "${GEPPETTO_COLLECTION}"
    elif [[ "${GEM_WORLD}" == puppetcore ]]; then
        echo puppetcore9      # PDK 4.x tests Puppet 9 by default
    else
        echo puppet8          # PDK 3.x ships Puppet 8.10
    fi
}

check_collection() {
    if [[ "$1" == puppetcore* && "${GEM_WORLD}" != puppetcore ]]; then
        die "collection $1 needs the Puppet Core gem world ($(gem_source))."
    fi
}

# Provision from either Docker images (array name in $1) or a provision.yaml set ($2).
provision_machines() {
    local -n images_ref="$1"
    local set="$2" image
    if ((${#images_ref[@]})); then
        for image in "${images_ref[@]}"; do
            [[ "${image}" =~ ^[A-Za-z0-9][A-Za-z0-9._/:@-]*$ ]] || die "invalid image name '${image}'."
            info "Provisioning ${image} (docker, not from provision.yaml)"
            run_rake "litmus:provision[docker,${image}]" || return 1
        done
    else
        grep -qE "^${set}:" "${MODULE_ROOT}/provision.yaml" 2>/dev/null \
            || die "set '${set}' not found in provision.yaml."
        info "Provisioning set '${set}'"
        run_rake "litmus:provision_list[${set}]" || return 1
    fi
}

install_agent_and_module() {
    local collection="$1"
    info "Installing agent (collection ${collection})"
    run_rake "litmus:install_agent[${collection}]" || return 1
    info "Installing module"
    run_rake litmus:install_module || return 1
}

module_name() { jq -r '.name' "${MODULE_ROOT}/metadata.json"; }

# Bolt against the machines in the Litmus inventory, from the module root.
bolt_run() {
    # BOLT_GEM: use Bolt from the module bundle (the same Bolt Litmus uses) on purpose.
    (cd "${MODULE_ROOT}" && BOLT_GEM=1 pdk_run bundle exec bolt "$@" \
        --targets all --inventoryfile "$(inventory_file)")
}

# --------------------------------------------------------------------------- acceptance

acceptance_teardown() {
    if ((ACC_PROVISIONED)) && ((ACC_KEEP == 0)); then
        info "Tearing down test machines"
        run_rake litmus:tear_down || warn "tear down failed; check 'docker ps' for leftovers."
    elif ((ACC_PROVISIONED)); then
        info "Keeping test machines (inventory: $(inventory_file))."
        info "Remove them later with: pm target down"
    fi
}

cmd_acceptance() {
    local set="" inventory="" collection="" keep=0 images=()
    while (($#)); do
        case "$1" in
            --set) set="${2:?--set needs a name}"; shift 2 ;;
            --image) images+=("${2:?--image needs an image}"); shift 2 ;;
            --inventory) inventory="${2:?--inventory needs a file}"; shift 2 ;;
            --collection) collection="${2:?--collection needs a name}"; shift 2 ;;
            --keep) keep=1; shift ;;
            *) die "acceptance: unknown option '$1'." ;;
        esac
    done
    local sources=0
    [[ -n "${set}" ]] && sources=$((sources + 1))
    [[ -n "${inventory}" ]] && sources=$((sources + 1))
    ((${#images[@]})) && sources=$((sources + 1))
    ((sources <= 1)) || die "use only one of --set, --image and --inventory."
    set="${set:-default}"
    collection="${collection:-$(default_collection)}"
    check_collection "${collection}"
    [[ -d "${MODULE_ROOT}/spec/acceptance" ]] || die "module has no spec/acceptance directory."
    if [[ -z "${inventory}" ]] && inventory_has_targets; then
        die "test machines from 'pm target up' are still running; remove them with 'pm target down' first."
    fi

    check_pdk_match
    ensure_bundle

    # Globals: the EXIT trap runs after this function's locals are gone.
    ACC_PROVISIONED=0
    ACC_KEEP="${keep}"
    trap acceptance_teardown EXIT

    if [[ -n "${inventory}" ]]; then
        [[ -f "${inventory}" ]] || die "inventory file ${inventory} not found."
        mkdir -p "$(dirname "$(inventory_file)")"
        cp "${inventory}" "$(inventory_file)"
        info "Using existing machines from ${inventory} (no provisioning, no tear down)"
    else
        ACC_PROVISIONED=1
        provision_machines images "${set}"
    fi

    install_agent_and_module "${collection}"
    info "Running acceptance tests"
    run_rake litmus:acceptance:parallel
    info "acceptance: OK"
}

# --------------------------------------------------------------------------- target / apply

cmd_target() {
    local sub="${1:-}"
    (($#)) && shift
    case "${sub}" in
        up)   target_up "$@" ;;
        exec) target_exec "$@" ;;
        down) target_down "$@" ;;
        *) die "target: use 'pm target up|exec|down' (see pm help)." ;;
    esac
}

target_up() {
    local set="" collection="" images=()
    while (($#)); do
        case "$1" in
            --set) set="${2:?--set needs a name}"; shift 2 ;;
            --image) images+=("${2:?--image needs an image}"); shift 2 ;;
            --collection) collection="${2:?--collection needs a name}"; shift 2 ;;
            *) die "target up: unknown option '$1'." ;;
        esac
    done
    [[ -z "${set}" || ${#images[@]} -eq 0 ]] || die "use either --set or --image."
    set="${set:-default}"
    collection="${collection:-$(default_collection)}"
    check_collection "${collection}"
    inventory_has_targets && die "test machines are already running; use them, or 'pm target down' first."

    check_pdk_match
    ensure_bundle
    if ! provision_machines images "${set}" || ! install_agent_and_module "${collection}"; then
        warn "setting up the test machine failed; removing it."
        run_rake litmus:tear_down || true
        exit 1
    fi
    info "Test machine ready. Next: pm apply FILE.pp | pm apply -e 'MANIFEST'; pm target exec CMD; pm target down"
}

target_exec() {
    (($#)) || die "target exec: which command? e.g. pm target exec 'cat /etc/motd'"
    inventory_has_targets || die "no test machine; start one with 'pm target up'."
    bolt_run command run "$*"
}

target_down() {
    if ! inventory_has_targets; then
        info "No test machines running."
        return 0
    fi
    info "Tearing down test machines"
    run_rake litmus:tear_down
    rm -f "$(inventory_file)"
    info "target down: OK"
}

# One puppet apply on every test machine. Prints Puppet's output and sets
# APPLY_CODES to the space-separated --detailed-exitcodes values.
apply_once() {
    local remote="$1" noop="$2" json
    local cmd="/opt/puppetlabs/bin/puppet apply --detailed-exitcodes --color=false ${noop:+--noop} ${remote}"
    json="$(bolt_run command run "${cmd}" --format json || true)"
    [[ -n "${json}" ]] || die "bolt returned no result; is the test machine still running? (pm target up)"
    jq -r '.items[] | "--- \(.target)", ((.value.stdout, .value.stderr, (if .value.exit_code == null then .value._error.msg else null end)) // empty | select(. != ""))' <<<"${json}"
    APPLY_CODES="$(jq -r '[.items[] | (.value.exit_code // 1)] | map(tostring) | join(" ")' <<<"${json}")"
}

cmd_apply() {
    local manifest="" inline="" noop=""
    while (($#)); do
        case "$1" in
            -e|--execute) inline="${2:?-e needs a manifest}"; shift 2 ;;
            --noop) noop=1; shift ;;
            -*) die "apply: unknown option '$1'." ;;
            *) [[ -z "${manifest}" ]] || die "apply: only one manifest file."; manifest="$1"; shift ;;
        esac
    done
    [[ -n "${manifest}" || -n "${inline}" ]] || die "apply: give a manifest file or -e 'MANIFEST'."
    [[ -z "${manifest}" || -z "${inline}" ]] || die "apply: use either a file or -e, not both."
    inventory_has_targets || die "no test machine; start one with 'pm target up'."

    local local_file
    if [[ -n "${inline}" ]]; then
        local_file="$(mktemp --suffix=.pp)"
        printf '%s\n' "${inline}" > "${local_file}"
    else
        [[ -f "${manifest}" ]] || die "manifest ${manifest} not found."
        local_file="$(readlink -f "${manifest}")"
    fi

    # Always test the current code: reinstall the module before applying.
    info "Reinstalling $(module_name) on the test machines"
    bolt_run command run "/opt/puppetlabs/bin/puppet module uninstall --force $(module_name)" >/dev/null || true
    run_rake litmus:install_module >/dev/null || die "could not reinstall the module on the test machines."

    local remote=/tmp/geppetto-apply.pp
    bolt_run file upload "${local_file}" "${remote}" >/dev/null || die "could not upload the manifest."
    [[ -n "${inline}" ]] && rm -f "${local_file}"

    local code failed=0
    if [[ -n "${noop}" ]]; then
        info "puppet apply --noop"
        apply_once "${remote}" 1
        for code in ${APPLY_CODES}; do
            case "${code}" in
                0) info "noop: no changes needed" ;;
                2) info "noop: changes would be made (see above)" ;;
                *) warn "noop: puppet reported failures (exit ${code})"; failed=1 ;;
            esac
        done
        ((failed == 0)) || die "apply --noop: FAILED"
        info "apply --noop: OK"
        return 0
    fi

    info "puppet apply (run 1: apply changes)"
    apply_once "${remote}" ""
    for code in ${APPLY_CODES}; do
        case "${code}" in
            0) info "run 1: no changes (already in the desired state)" ;;
            2) info "run 1: changes applied (see above)" ;;
            *) warn "run 1: puppet reported failures (exit ${code})"; failed=1 ;;
        esac
    done
    ((failed == 0)) || die "apply: FAILED in run 1"

    info "puppet apply (run 2: idempotence check)"
    apply_once "${remote}" ""
    for code in ${APPLY_CODES}; do
        case "${code}" in
            0) info "run 2: no changes (idempotent)" ;;
            2) warn "run 2: puppet changed resources again: NOT idempotent"; failed=1 ;;
            *) warn "run 2: puppet reported failures (exit ${code})"; failed=1 ;;
        esac
    done
    ((failed == 0)) || die "apply: FAILED in run 2 (idempotence)"
    info "apply: OK (changes applied, second run idempotent)"
}

cmd_pdk_update() {
    local noop=0
    [[ "${1:-}" == "--noop" ]] && noop=1
    local target
    target="$(container_pdk_version)"
    info "Changes needed to move the module from PDK $(module_pdk_version) to ${target}:"
    (cd "${MODULE_ROOT}" && pdk_run update --noop) || true
    ((noop)) && return 0
    info "pdk update"
    (cd "${MODULE_ROOT}" && pdk_run update --force)
    ensure_bundle force
    cmd_validate
    cmd_unit
    info "pdk-update: module is now on PDK ${target}. Review 'git diff' and commit."
}

cmd_push() {
    local branch
    branch="$(git_m symbolic-ref --quiet --short HEAD)" || die "not on a branch."
    [[ "${branch}" == agent/* ]] \
        || die "only agent/* branches are pushed (current: ${branch}). Use 'pm branch TOPIC'."
    local origin_default
    origin_default="$(default_branch origin)"
    [[ "${branch}" != "${origin_default}" ]] || die "refusing to push the default branch."

    if [[ -n "$(git_m status --porcelain)" ]]; then
        warn "uncommitted changes are not pushed:"
        git_m status --short >&2
    fi

    # Never push secrets: scan the commits that would be published.
    local base_ref=origin
    git_m remote get-url upstream >/dev/null 2>&1 && base_ref=upstream
    local base
    base="$(git_m merge-base HEAD "${base_ref}/$(default_branch "${base_ref}")" 2>/dev/null || true)"
    local range="${base:+${base}..}HEAD" var
    for var in GH_TOKEN FORGE_TOKEN; do
        # Process substitution: with pipefail, `git log | grep -q` would report SIGPIPE.
        if [[ -n "${!var:-}" ]] && grep -qF -- "${!var}" <(git_m log -p "${range}"); then
            die "the commits contain a token (${var/#FORGE_TOKEN/PUPPET_FORGE_TOKEN}). Remove it from the history before pushing."
        fi
    done

    # Transparency: every agent commit should carry an Assisted-by line. Checked as a
    # line anywhere in the message, not via git's trailer parser: git only recognises
    # the last paragraph, and agents often add their own trailer block after ours.
    local missing="" sha
    while read -r sha; do
        [[ -n "${sha}" ]] || continue
        git_m log -1 --format=%B "${sha}" | grep -qiE '^Assisted-by:[[:space:]]*[^[:space:]]' \
            || missing+="  $(git_m log -1 --format='%h %s' "${sha}")"$'\n'
    done < <(git_m rev-list "${range}")
    if [[ -n "${missing}" ]]; then
        warn "these commits have no 'Assisted-by:' line (see AGENTS.md):"
        printf '%s' "${missing}" >&2
    fi

    info "Pushing ${branch} to origin"
    git_m push --set-upstream origin "HEAD:refs/heads/${branch}"

    # Compare link: upstream default branch ... fork branch.
    local fork_repo upstream_repo
    fork_repo="$(github_repo origin)"
    upstream_repo="$(github_repo upstream)"
    if [[ -n "${fork_repo}" && -n "${upstream_repo}" ]]; then
        info "Ready for review. Compare against upstream:"
        echo "    https://github.com/${upstream_repo}/compare/$(default_branch upstream)...${fork_repo%%/*}:${fork_repo#*/}:${branch}"
    fi
}

# --------------------------------------------------------------------------- main

main() {
    local cmd="${1:-help}"
    (($#)) && shift
    case "${cmd}" in
        help|-h|--help) usage; return ;;
        _sync-credentials) sync_bundle_credentials; return ;;   # used by the entrypoint
    esac
    find_module_root
    prepare_env
    case "${cmd}" in
        info)       cmd_info ;;
        setup)      cmd_setup ;;
        branch)     cmd_branch "$@" ;;
        validate)   cmd_validate "$@" ;;
        unit)       cmd_unit "$@" ;;
        acceptance) cmd_acceptance "$@" ;;
        target)     cmd_target "$@" ;;
        apply)      cmd_apply "$@" ;;
        pdk-update) cmd_pdk_update "$@" ;;
        push)       cmd_push ;;
        *) usage >&2; exit 1 ;;
    esac
}

main "$@"
